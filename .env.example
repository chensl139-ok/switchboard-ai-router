# npm run setup 自动生成两个独立令牌，不覆盖已有 .env。
ADMIN_TOKEN=
GATEWAY_TOKEN=
# Node 直接运行使用以下设置；Docker 容器内部固定监听 3000。
HOST=127.0.0.1
PORT=3000
LOCAL_PORT=3000
# DATA_DIR 省略时为当前应用目录下 data；Docker 固定挂载到 /app/data。
# DATA_DIR=/absolute/persistent/path
# 公网 Docker+Caddy 部署时填写已解析到服务器的域名。
GATEWAY_DOMAIN=
# 精确 Origin 列表，默认仅同源；不支持 *。
WS_ALLOWED_ORIGINS=
# 默认禁止 HTTP 上游。仅访问受信任的本地推理服务时启用。
ALLOW_HTTP_UPSTREAM=false
# 公网 HTTPS 反向代理建议强制 Secure Cookie（本地 HTTP 留空或 false）。
COOKIE_SECURE=false
# 飞书企业自建应用网页 OAuth。三项同时配置后登录页会显示“使用飞书登录”。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 必须与飞书开放平台安全设置中的重定向 URL 完全一致。
FEISHU_REDIRECT_URI=
# 建议填写企业 tenant_key，防止其他飞书企业账户加入。
FEISHU_ALLOWED_TENANT_KEY=
# true 时同企业用户无需邀请即可加入默认租户；仅在同时配置 tenant_key 时生效。
FEISHU_AUTO_JOIN=false
FEISHU_DEFAULT_ROLE=member
# 仅当本机使用 Fake-IP 代理时启用；仅放行官方域名及下方精确列出的自定义域名的 198.18/15 虚拟地址。
UPSTREAM_PROXY_FAKE_IP=false
# 自定义服务商域名，逗号分隔；不要写 URL、端口或通配符。
UPSTREAM_PROXY_FAKE_IP_HOSTS=
# 私有推理服务须由部署管理员精确授权域名/IP，逗号分隔。
UPSTREAM_ALLOWED_PRIVATE_HOSTS=
