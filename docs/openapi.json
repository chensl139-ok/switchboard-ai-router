{
  "openapi": "3.0.3",
  "info": {
    "title": "Switchboard API",
    "version": "2.0.0"
  },
  "paths": {
    "/openapi/v1/chat/completions": {
      "post": {
        "operationId": "chatCompletion",
        "summary": "生成文本回复",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "object",
                    "created",
                    "model",
                    "choices",
                    "usage",
                    "routing"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "chatcmpl-123"
                    },
                    "object": {
                      "type": "string",
                      "enum": [
                        "chat.completion"
                      ],
                      "example": "chat.completion"
                    },
                    "created": {
                      "type": "integer",
                      "example": 1789230000
                    },
                    "model": {
                      "type": "string",
                      "example": "deepseek-chat"
                    },
                    "choices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "example": {
                          "index": 0,
                          "message": {
                            "role": "assistant",
                            "content": "你好"
                          },
                          "finish_reason": "stop"
                        }
                      }
                    },
                    "usage": {
                      "type": "object",
                      "example": {
                        "prompt_tokens": 2,
                        "completion_tokens": 3,
                        "total_tokens": 5
                      }
                    },
                    "routing": {
                      "type": "object",
                      "example": {
                        "providerId": "deepseek",
                        "reason": "显式指定服务商与模型",
                        "attempts": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数无效"
          },
          "429": {
            "description": "请求超限"
          },
          "502": {
            "description": "上游失败"
          },
          "504": {
            "description": "请求超时"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "messages"
                ],
                "additionalProperties": false,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "auto"
                  },
                  "upstream_model": {
                    "type": "string",
                    "example": "deepseek-chat"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "user",
                            "assistant",
                            "system"
                          ],
                          "example": "user"
                        },
                        "content": {
                          "type": "string",
                          "example": "你好"
                        }
                      }
                    }
                  },
                  "max_tokens": {
                    "type": "integer",
                    "example": 2048,
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "temperature": {
                    "type": "number",
                    "example": 0.7,
                    "minimum": 0,
                    "maximum": 2
                  },
                  "stream": {
                    "type": "boolean",
                    "enum": [
                      false
                    ],
                    "example": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi/v1/models": {
      "get": {
        "operationId": "listModels",
        "summary": "列出已配置的调用路由",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "object",
                    "data"
                  ],
                  "properties": {
                    "object": {
                      "type": "string",
                      "example": "list"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "example": {
                          "id": "auto",
                          "object": "model",
                          "owned_by": "router"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数无效"
          },
          "429": {
            "description": "请求超限"
          },
          "502": {
            "description": "上游失败"
          },
          "504": {
            "description": "请求超时"
          }
        }
      }
    }
  }
}